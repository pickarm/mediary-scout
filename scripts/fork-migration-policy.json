{
  "format": "media-track-fork-migration-policy@1",
  "localHosts": ["localhost", "127.0.0.1", "::1"],
  "isolatedHosts": [],
  "rehearsalEnv": {
    "MEDIA_TRACK_REHEARSAL": "1",
    "MEDIA_TRACK_INPROCESS_WORKER": "0",
    "MEDIA_TRACK_STORAGE_ADAPTER": "fake",
    "MEDIA_TRACK_AGENT_ADAPTER": "fake",
    "MEDIA_TRACK_WORKFLOW_ADAPTER": "fake",
    "MEDIA_TRACK_SEARCH_PROVIDER": "demo",
    "MEDIA_TRACK_DEMO_SEED": "0",
    "MEDIA_TRACK_DISTRIBUTION": "fork-image",
    "REDIS_URL": ""
  },
  "rehearsalBlockedEnv": [
    "PAN115_COOKIE",
    "PAN115_REFRESH_TOKEN",
    "QUARK_COOKIE",
    "TIANYI_COOKIE",
    "PAN123_COOKIE",
    "MEDIA_TRACK_115_WRITE_SCOPE_CIDS",
    "MEDIA_TRACK_115_TEST_ROOT_CID",
    "MEDIA_TRACK_115_PROTECTED_CIDS",
    "MEDIA_TRACK_115_ROOT_CID",
    "CLAWD_MEDIA_ROOT_CID",
    "MOVIES_CID",
    "TV_SHOWS_CID",
    "ANIME_CID",
    "TUNNEL_TOKEN",
    "MEDIA_TRACK_WORKER_SECRET",
    "AGENT_MODEL_API_KEY",
    "TMDB_READ_TOKEN",
    "JEV_API_KEY",
    "PROWLARR_API_KEY",
    "HAISOU_API_KEY",
    "PANSOU_BASE_URL",
    "REDIS_URL"
  ],
  "rehearsalAllowedEnv": [
    "PATH",
    "HOME",
    "USERPROFILE",
    "TEMP",
    "TMP",
    "SystemRoot",
    "ComSpec",
    "PATHEXT",
    "OS",
    "NUMBER_OF_PROCESSORS",
    "NODE_ENV",
    "LANG",
    "LC_ALL",
    "TZ",
    "NEXT_TELEMETRY_DISABLED"
  ],
  "fingerprintTables": [
    {
      "id": "media_titles",
      "table": "media_titles",
      "columns": ["id", "payload"],
      "group": "works",
      "required": true
    },
    {
      "id": "tracked_seasons",
      "table": "tracked_seasons",
      "columns": ["id", "media_title_id", "payload"],
      "group": "tracking",
      "required": true
    },
    {
      "id": "episode_states",
      "table": "episode_states",
      "columns": ["tracked_season_id", "episode_code", "payload"],
      "group": "tracking",
      "required": true
    },
    {
      "id": "episode_copies",
      "table": "episode_copies",
