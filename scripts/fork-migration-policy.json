  "backup": {
    "dumpFormat": "custom",
    "dumpArgs": ["--format=custom", "--no-owner", "--no-acl", "--compress=6"],
    "restoreArgs": ["--clean", "--if-exists", "--no-owner", "--no-acl", "--single-transaction"]
